@page "/Recursos/{Elemento}/{idRecurso:int}"
@rendermode InteractiveServer
@inject HttpClient Http
@inject TokenService Token
@using System.Net.Http.Json
@using MonitoreoDashboard.Models
@using Radzen
@using Radzen.Blazor
@using MonitoreoDashboard.Services


@if (!error)
{
    <div class="d-flex flex-row p-3 align-items-stretch mb-5">
        <span class="material-icons align-content-xxl-center text-center me-5" style="font-size: 10vw; aspect-ratio: 1/1">precision_manufacturing</span>
        <div class="d-flex ms-4 flex-column">
            <h1>@Equipo.Nombre</h1>
            <h3 class="mb-4">@Equipo.Modelo</h3>            
            <h5 class="mb-4">Online</h5>
            <h6>Etiqueta de servicio: 43XXJR3</h6>
            <h6>Servicios de soporte y garantía: Termina en febrero 21, 2029</h6>
        </div>
        <div class="d-flex flex-row gap-2 ms-auto">
            <button class="btn-negro" id="btn-new-client">
                <i class="material-icons">edit</i>
                <span>Editar</span>
            </button>
            <button class="btn-negro" id="btn-new-client">
                <i class="material-icons">delete</i>
                <span>Eliminar</span>
            </button>
        </div>
    </div>
    <div class="container-fluid"> 
        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-4">
                 <Card>
            <div class="d-flex flex-row align-items-center gap-3">
                <i class="material-icons">info</i>
                <h4>Información general</h4>                
            </div>
            <div class="d-flex flex-row align-items-center gap-3">                                                
                <h5>Dirección IP :</h5>
                <p>@Equipo.Direccion_IP</p>
            </div>
                    <div class="d-flex flex-row align-items-center gap-3">
                        <h5>Puerto: </h5>
                        <p>@Equipo.Puerto</p>
                    </div>
                    <div class="d-flex flex-row align-items-center gap-3">
                        <h5>Ultima conexión: </h5>
                        <p>@Equipo.Heartbeat</p>
                    </div>

        </Card>           
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <Card>
                    <div class="d-flex flex-row align-items-center gap-3">
                        <i class="material-icons">storage</i>
                        <h4>Memoria</h4>
                    </div>
                    <RadzenChart>
                        <RadzenLegend Visible="false" />

                        <RadzenDonutSeries Data="@memoria"
                                           CategoryProperty="Estado"
                                           ValueProperty="Cantidad"
                                           Title="87%"
                                           Fills="@colores" />

                    </RadzenChart>
                </Card>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <Card>
                    <div class="d-flex flex-row align-items-center gap-3">
                        <i class="material-icons">memory</i>
                        <h4>CPU</h4>                   
                    </div>
                    <RadzenChart>
                        <RadzenLegend Visible="false"/>
                        
                        <RadzenDonutSeries Data="@memoria"
                                           CategoryProperty="Estado"
                                           ValueProperty="Cantidad"
                                           Title=""
                                           Fills="@colores"
                                           />

                    </RadzenChart>
                </Card>
            </div>
        </div>

    </div>
   <div class="d-grid grid">
       
       
       
   </div>
}
else
{
    <NotFound/>
}

@code {
    [Parameter]
    public string Elemento { get; set; } = "";
    [Parameter]
    public int idRecurso { get; set; }


    private Equipo Equipo = new();

    private string[] colores = { "#000", "#fff" };
    private int idTipoRecurso;
    private bool error = false;

    protected override async Task OnInitializedAsync()
    {
        switch (Elemento)
        {
            case "Computadoras":
                idTipoRecurso = 3;
                break;
            case "PLCs":
                idTipoRecurso = 4;
                break;
            case "Impresoras":
                idTipoRecurso = 5;
                break;
            default:
                error = true;
                break;
        }
        var response = await Http.GetAsync($"Equipos/{idRecurso}");
        if (response.IsSuccessStatusCode)
        {
            Equipo = await response.Content.ReadFromJsonAsync<Equipo>() ?? new();
            Console.WriteLine(Equipo);
        }
    }

    private class MemoriaDato
    {
        public string Estado { get; set; } = "";
        public double Cantidad { get; set; }
    }

    private List<MemoriaDato> memoria => new()
    {
        new() {Estado = "Usada", Cantidad = Equipo.CPU ?? 0 },
        new() {Estado = "Disponible", Cantidad =  Equipo.CPU != null ? (double)(100 - Equipo.CPU) : 100  }
    };


}

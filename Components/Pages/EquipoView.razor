@rendermode InteractiveServer

@page "/Recursos/{Elemento}/{idRecurso:int}"

@using System.Net.Http.Json
@using MonitoreoDashboard.Models
@using Radzen.Blazor
@using System.Text.Json

@inject HttpClient Http
@inject IJSRuntime js


@if (!error)
{
    <div class="container-fluid">
       
        <div class="d-flex ms-4 flex-column">
            <h1><b>@Equipo.Nombre</b></h1>
            <h3 >@Equipo.Modelo</h3>
            <h5 class="mb-5" style="color: #9ca3af;">
                @if (Equipo.Area != null)
                {
                    @Equipo.Area.Nombre
                }
            </h5>
            <div class="container-fluid">                
                <div class="row">
                    <div class="col-12 col-md-6 col-lg-3 p-0" >
                        @if (Equipo.Area != null && Equipo.Area.Planta != null)
                        {
                            <InformationLabel Title="Planta" > 
                                @Equipo.Area.Planta.Nombre
                            </InformationLabel>
                        }
                    </div>
                    <div class="col-12 col-md-6 col-lg-3 p-0">
                        <InformationLabel Title="Service Tag">43XXJR3 </InformationLabel>
                        </div>
                    <div class="col-12 col-md-6 col-lg-3 p-0">
                        <InformationLabel Title="Garantía">21 de febrero, 2029</InformationLabel>
                    </div>                   
                    <div class="col-12 col-md-6 col-lg-3 p-0">
                        <InformationLabel Title="Última conexión">Hace un min </InformationLabel>
                    </div>
                </div>
            </div>            
        </div>
        <div class=" p-4 d-flex flex-column">         
            <div class="d-flex flex-row">
                <strong>
                    USO DE LA CPU
                </strong>
                <p class="ms-auto">
                    @cpu%
                </p>
            </div>
            <RadzenProgressBar class="progress-bar" Value="@cpu" Min="0" Max="100" ShowValue="false" />
        </div>
        <div class="px-4 d-flex flex-column">
            <div class="d-flex flex-row">
                <strong>
                    USO DE LA MEMORIA
                </strong>
                <p class="ms-auto">
                    @memoria%
                </p>
            </div>
            <RadzenProgressBar class="progress-bar" Value="@memoria" Min="0" Max="100" ShowValue="false" />
        </div>        
    </div>
    <div class="container-fluid mt-5">
        <div class="row g-4">           
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card-description">
                    <InformationLabel Title="Dirección IP" Error="No asignada"> @Equipo.Direccion_IP </InformationLabel></div>
                </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card-description">
                    <InformationLabel Title="Puerto" Error="No asignado" > @Equipo.Puerto </InformationLabel>
                 </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card-description">
                    @if (Equipo.TipoRecurso != null)
                    {
                        <InformationLabel Title="Tipo de recurso"> @Equipo.TipoRecurso.Nombre </InformationLabel>
                    }                    
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card-description">
                    <InformationLabel Title="Código"> @Equipo.Codigo</InformationLabel>
                </div>
            </div>
        </div>
    </div>
     
}
else
{
    <NotFound/>
}

@code {
    [Parameter]
    public string Elemento { get; set; } = "";
    [Parameter]
    public int idRecurso { get; set; }    

    private string? token;
    private string key = "tokenKEY";
    private Equipo Equipo = new();


    private int idTipoRecurso;
    private double cpu = 0;
    private double memoria = 0;
    private bool error = false;

    protected override async Task OnInitializedAsync()
    {
        switch (Elemento)
        {
            case "Computadoras":
                idTipoRecurso = 3;
                break;
            case "PLCs":
                idTipoRecurso = 4;
                break;
            case "Impresoras":
                idTipoRecurso = 5;
                break;
            default:
                error = true;
                break;
        }
        var response = await Http.GetAsync($"Equipos/{idRecurso}");
        if (response.IsSuccessStatusCode)
        {
            Equipo = await response.Content.ReadFromJsonAsync<Equipo>() ?? new();
            if (Equipo.CPU != null)
                cpu = (double)Equipo.CPU;

            if (Equipo.Memoria != null)
                memoria = (double)Equipo.Memoria;
        }
    }

    


}

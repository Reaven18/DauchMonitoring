@inherits LayoutComponentBase

<div class="box-shadow display-none">
    </div>
    <div class="d-flex">   
        <NavMenu />
        <!-- CONTENIDO -->
        <div class="main-content">
            <div class="d-flex gap-3 align-content-center w-100 ps-4 pe-2 py-4">
                <button id="btnLaunch" class=" btn-launch">
                    <span class="material-symbols-outlined icon-lauch">
                        left_panel_open
                    </span>
                </button>
                <button id="btnMenu" class="btn-launch">
                    <span class="material-symbols-outlined icon-lauch">
                        menu
                    </span>
                </button>
                <div class="sidebar-header">
                    <span class="text-dark">Monitoreo</span>
                    <span>Historial</span>
                    <span>Analisis</span>
                    <span>Areas</span>
                    <span>Plantas</span>
                </div>
                <div class="d-flex gap-4 align-items-center ms-auto">
                    <span class="material-symbols-outlined sidebar-icon">notifications</span>
                    <span class="material-icons sidebar-icon">settings</span>
                    <div class="user-avatar">
                        A
                    </div>
                </div>
            </div>
            <main class="body-container">
                @Body 
            </main>
        </div>
    </div>